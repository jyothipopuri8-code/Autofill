{
  "manifest_version": 3,
  "name": "Autofill Agent",
  "version": "0.1.0",
  "description": "Fills job applications from your local Autofill Agent. Never submits for you.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Autofill Agent", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'" }
}
